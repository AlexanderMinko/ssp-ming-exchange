<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- One shape for every line (26/11/2026, ssp-backend's model): DslJsonLogbackEncoder writes one JSON object per
         line: @timestamp, level, logger_name, thread_name, message, service_name, the MDC (traceId, spanId), then
         payload = every kv(...) argument and SLF4J key-value pair, then stack_trace. Call sites:
         log.info("request rejected", kv("requestId", id)), constant message, values in kv. No hand-built JSON.
         A stack trace stays inside one JSON line, so the collectors need no multiline parsing. -->
    <conversionRule conversionWord="kvargs" class="com.ming.sspexchange.logging.LogFieldConverter"/>

    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="com.ming.sspexchange.logging.DslJsonLogbackEncoder">
            <serviceName>exchange</serviceName>
        </encoder>
    </appender>

    <!-- Framework noise, quietened in every profile, as ssp-backend's logback-commons-spring.xml does: these
         libraries are chatty at INFO (DispatcherServlet init, Tomcat port, Mongo driver) and bury the service's own
         lines. Their WARN and ERROR still come through. Outside the profile blocks so no profile can forget them. -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.mongodb" level="WARN"/>
    <logger name="org.apache" level="WARN"/>

    <!-- Laptop (SPRING_PROFILES_ACTIVE=local): readable text on the console (kv fields via %kvargs, SLF4J key-value
         pairs via %kvp), and the same JSON lines as on EKS in ~/.ssp-ming/logs/exchange.json, which the local SigNoz
         ingester tails with the EKS agent's operator chain (observability/signoz/ingester/ingester.yaml). -->
    <springProfile name="local">
        <!-- Boot 4.1.2's default console pattern (defaults.xml) with %kvargs %kvp after the message. Copied, so
             re-check it after a Boot upgrade. Set before the include, which reads CONSOLE_LOG_PATTERN. -->
        <property name="CONSOLE_LOG_PATTERN" value="%clr(%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd'T'HH:mm:ss.SSSXXX}}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}){} %clr(${PID:-}){magenta} %clr(--- %esb(){APPLICATION_NAME}%esb{APPLICATION_GROUP}[%15.15t] ${LOG_CORRELATION_PATTERN:-}){faint}%clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%kvargs %kvp%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>
        <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

        <!-- Rolled archives are .json.gz, so the collector's *.json glob reads only the live file. -->
        <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${user.home}/.ssp-ming/logs/exchange.json</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
                <fileNamePattern>${user.home}/.ssp-ming/logs/exchange.%i.json.gz</fileNamePattern>
                <minIndex>1</minIndex>
                <maxIndex>3</maxIndex>
            </rollingPolicy>
            <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
                <maxFileSize>50MB</maxFileSize>
            </triggeringPolicy>
            <encoder class="com.ming.sspexchange.logging.DslJsonLogbackEncoder">
                <serviceName>exchange</serviceName>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="JSON_FILE"/>
        </root>
    </springProfile>

    <!-- Cluster and tests: every line through the JSON encoder on stdout, tailed by the SigNoz agent. -->
    <springProfile name="!local">
        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
        </root>
    </springProfile>
</configuration>
